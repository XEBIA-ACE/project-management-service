# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────
# Auth (OAuth2 / JWT)
# ──────────────────────────────────────────────
# JWKS endpoint for token verification (e.g. Auth0, Keycloak)
JWKS_URI=https://your-auth-provider/.well-known/jwks.json
# Expected JWT audience
JWT_AUDIENCE=project-management-service
# Expected JWT issuer
JWT_ISSUER=https://your-auth-provider/
# JWT algorithm (RS256 recommended for production)
JWT_ALGORITHM=RS256
# Shared secret — only used when JWT_ALGORITHM=HS256 (dev/test only)
JWT_SECRET=change-me-in-production

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
# Set to "true" to use the in-memory repository instead of PostgreSQL
USE_IN_MEMORY_REPO=true

# ──────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=info

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGIN=*
